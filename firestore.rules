rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.token.email);
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ammar.ali.khandoker.sml@gmail.com';
    }

    function isAdmin() {
      return isSignedIn()
        && (
          isSuperAdmin()
          || (
            exists(roleDoc())
            && get(roleDoc()).data.role == 'admin'
          )
        );
    }

    function isStore() {
      return isSignedIn()
        && exists(roleDoc())
        && (
          get(roleDoc()).data.role == 'staff'
          || get(roleDoc()).data.role == 'store'
        );
    }

    function adminMainUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['items', 'seq', 'categories', 'groups', 'suppliers', 'settings', 'client', 'rev']);
    }

    function storeMainUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['items', 'seq', 'client', 'rev']);
    }

    function validTxnCreate(txId) {
      return request.resource.data.keys().hasAll([
          'id', 'type', 'subtype', 'date', 'itemId', 'qty', 'by', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'type', 'subtype', 'poId', 'poNo', 'referenceId',
          'supplierId', 'referenceNo', 'department', 'issuedTo',
          'purpose', 'date', 'itemId', 'qty', 'note', 'by', 'createdAt'
        ])
        && request.resource.data.id == txId
        && request.resource.data.type in ['IN', 'OUT']
        && request.resource.data.subtype in [
          'NORMAL', 'OPENING', 'ADJUSTMENT', 'REVERSAL', 'RETURN'
        ]
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.itemId is string
        && request.resource.data.qty is number
        && request.resource.data.qty != 0
        && (
          (request.resource.data.type == 'IN' && request.resource.data.qty > 0)
          || (request.resource.data.type == 'OUT' && request.resource.data.qty < 0)
        )
        && request.resource.data.by is string
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt > 0;
    }

    function validAuditCreate(auditId) {
      return request.resource.data.keys().hasAll([
          'id', 'ts', 'date', 'time', 'user', 'action'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'ts', 'date', 'time', 'user', 'action'
        ])
        && request.resource.data.id == auditId
        && request.resource.data.ts is number
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.user is string
        && request.resource.data.action is string;
    }

    match /roles/{email} {
      allow read: if isSignedIn()
        && (email == request.auth.token.email || isSuperAdmin());

      allow create, update, delete: if isSuperAdmin();
    }

    match /erp/{docId} {
      allow read: if isSignedIn();

      allow create: if isSuperAdmin() || isAdmin();

      allow update: if isSuperAdmin()
        || (
          isAdmin()
          && !isSuperAdmin()
          && docId == 'main'
          && adminMainUpdateAllowed()
        )
        || (
          isStore()
          && docId == 'main'
          && storeMainUpdateAllowed()
        );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /erp_txns/{txId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isStore()) && validTxnCreate(txId);
      allow update, delete: if false;
    }

    match /erp_audit/{auditId} {
      allow read: if isAdmin() || isStore();
      allow create: if (isAdmin() || isStore()) && validAuditCreate(auditId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
