rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'admin';
    }

    function isStore() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
        && (
          get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'staff'
          || get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'store'
        );
    }

    match /roles/{email} {
      allow read: if isSignedIn() && (email == request.auth.token.email || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /erp/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isStore();
      allow delete: if isAdmin();
    }

    match /erp_txns/{txId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isStore();
      allow update, delete: if false;
    }

    match /erp_audit/{auditId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isStore();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
